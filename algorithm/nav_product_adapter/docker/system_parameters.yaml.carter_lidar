general:
  lidar_fov_angle_margin_writable: 0.1
  lidar_fov_range_margin_writable: 0.2
  max_obstacle_height: 1
  min_obstacle_height: 0.1
navigation:
  fixed_point_navigation:
    angular_kp: 1.5
    forward_safety_distance: 0.8
    holonomic: false
    lateral_safety_distance: 0.1
    linear_kp: 0.8
    max_angular_acceleration: 1
    max_angular_speed: 0.5
    max_linear_acceleration: 0.5
    max_linear_speed: 0.5
    xy_goal_tolerance: 0.05
    yaw_goal_tolerance: 0.15
  free_navigation:
    angular_speed: 0.5
    linear_speed: 0.5
    safety_distance: 0.1
    xy_goal_tolerance: 0.25
    yaw_goal_tolerance: 0.25
relocalization:
  max_local_xy_jump: 0.75
  max_local_yaw_jump: 0.35
  max_local_z_jump: 0.5
robot:
  footprint:
  - - 0.3
    - 0.16
  - - 0.3
    - -0.16
  - - -0.35
    - -0.16
  - - -0.35
    - 0.16
  lidar_height: 0.444862
  lidar_pitch_writable: 0.0
