#!/bin/bash
#
# Git post-checkout hook to warn about invalid branch names immediately
#
# This runs after: git checkout -b <branch>, git switch -c <branch>
#

# $3 = 1 means branch change (not file checkout)
if [ "$3" != "1" ]; then
    exit 0
fi

# Get current branch name
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

# If we can't get branch name (detached HEAD), skip check
if [ -z "$BRANCH_NAME" ]; then
    exit 0
fi

# Define allowed branch patterns
MAIN_BRANCHES="^(main|master|develop|development)$"
PREFIX_BRANCHES="^(feature|bugfix|hotfix|release|chore|docs|refactor|test|ci|fix|perf|style|build)/.+$"

# Check if branch matches allowed patterns
if echo "$BRANCH_NAME" | grep -qE "$MAIN_BRANCHES"; then
    exit 0
fi

if echo "$BRANCH_NAME" | grep -qE "$PREFIX_BRANCHES"; then
    exit 0
fi

# Branch name doesn't match - show warning
echo ""
echo "========================================="
echo "  ⚠️  BRANCH NAMING WARNING"
echo "========================================="
echo ""
echo "Branch '$BRANCH_NAME' does not follow naming conventions."
echo "You will NOT be able to push this branch."
echo ""
echo "Please rename it without deleting the branch:"
printf '  git branch -m -- %q %q\n' "$BRANCH_NAME" 'feature/<name>'
printf '  git branch -m -- %q %q\n' "$BRANCH_NAME" 'bugfix/<name>'
printf '  git branch -m -- %q %q\n' "$BRANCH_NAME" 'chore/<name>'
echo ""
echo "========================================="

# Exit 0 to not block checkout, just warn
exit 0
