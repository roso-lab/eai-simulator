    "configuration_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resume"
      }
    },
    "resumes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resume"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterocoord.local/schema/robot_pool_resume_review.v1.json",
  "$defs": {
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_id",
        "profile_id",
        "name_zh",
        "record_type",
        "identity",
        "deployment",
        "configuration",
        "mobility",
        "manipulation",
        "sensing",
        "skills",
        "runtime_state",
        "special_notes_zh",
        "source_refs"
      ],
      "properties": {
        "resume_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "name_zh": {
          "type": "string"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "configuration_profile",
            "configuration_variant"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform_type",
            "host_platform",
            "configuration_role",
            "robot_id",
            "configuration_id",
            "generation"
          ],
          "properties": {
            "platform_type": {
              "type": "string"
            },
            "host_platform": {
              "type": [
                "string",
                "null"
              ]
            },
            "configuration_role": {
              "type": "string"
            },
            "robot_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "configuration_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "generation": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "attachment_validation",
            "catalog_error",
            "controller_binding",
            "selection_path",
            "controller_maturity",
            "known_instability_zh",
            "fall_recovery",
            "runtime_blockers_zh",
            "reason_zh",
            "evidence_scope_zh",
            "runtime_qualified"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "catalog_registered",
                "registered_blocked",
                "conditional",
                "rejected",
                "declared_unwired",
                "pending_integration"
              ]
            },
            "attachment_validation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "catalog_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "controller_binding": {
              "type": "string"
            },
            "selection_path": {
              "type": "string"
            },
            "controller_maturity": {
              "type": "string",
              "enum": [
                "standard",
                "stable",
                "experimental_unstable",
                "deployment_baseline_limited"
              ]
            },
            "known_instability_zh": {
              "type": [
                "string",
                "null"
              ]
            },
            "fall_recovery": {
              "type": "string",
              "enum": [
                "unknown",
                "unsupported"
              ]
            },
            "runtime_blockers_zh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason_zh": {
              "type": "string"
            },
            "evidence_scope_zh": {
              "type": "string"
            },
            "runtime_qualified": {
              "type": "boolean"
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motion_controller",
            "controller_variant",
            "manipulator_controller",
            "external_manipulator",
            "primary_manipulator",
            "attachments",
            "sensor_attachments",
            "builtin_sensor_suite",
            "default_sensor_suite",
            "tools",
            "mount_pose",
            "asset_variant_zh"
          ],
          "properties": {
            "motion_controller": {
              "type": [
                "string",
                "null"
              ]
            },
            "controller_variant": {
              "type": [
                "string",
                "null"
              ]
            },
            "manipulator_controller": {
              "type": [
                "string",
                "null"
              ]
            },
            "external_manipulator": {
              "type": [
                "string",
                "null"
              ]
            },
            "primary_manipulator": {
              "type": [
                "string",
                "null"
              ]
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sensor_attachments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "builtin_sensor_suite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "default_sensor_suite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            },
            "mount_pose": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "translation_m",
                "rotation_wxyz",
                "reference_frame"
              ],
              "properties": {
                "translation_m": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation_wxyz": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "reference_frame": {
                  "type": "string"
                }
              }
            },
            "asset_variant_zh": {
              "type": "string"
            }
          }
        },
        "mobility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "mode",
            "domain",
            "navigation_dimension",
            "stationary_configuration",
            "stairs",
            "speed_limit_mps",
            "min_turning_radius_m",
            "holding_navigation",
            "simultaneous_locomotion_manipulation"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "navigation_dimension": {
              "type": [
                "string",
                "null"
              ]
            },
            "stationary_configuration": {
              "type": "boolean"
            },
            "stairs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ascent",
                "descent",
                "basis",
                "display"
              ],
              "properties": {
                "ascent": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "unsupported",
                    "supported_unstable",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "descent": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "unsupported",
                    "supported_unstable",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "basis": {
                  "type": "string"
                },
                "display": {
                  "type": "string"
                }
              }
            },
            "speed_limit_mps": {
              "type": [
                "number",
                "null"
              ]
            },
            "min_turning_radius_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "holding_navigation": {
              "type": "string"
            },
            "simultaneous_locomotion_manipulation": {
              "type": "string"
            }
          }
        },
        "manipulation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "arm_count",
            "model",
            "end_effector",
            "execution_mode",
            "payload_kg",
            "max_pickplace_z_m",
            "height_frame",
            "height_limit_point",
            "payload_mass_basis",
            "min_pickplace_z_m",
            "radial_workspace_m",
            "arbitrary_object_orientation",
            "limits_source"
          ],
          "properties": {
            "origin": {
              "type": "string",
              "enum": [
                "none",
                "attached",
                "integrated",
                "primary_robot"
              ]
            },
            "arm_count": {
              "type": "number"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "end_effector": {
              "type": [
                "string",
                "null"
              ]
            },
            "execution_mode": {
              "type": "string"
            },
            "payload_kg": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_pickplace_z_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "height_frame": {
              "type": [
                "string",
                "null"
              ]
            },
            "height_limit_point": {
              "type": [
                "string",
                "null"
              ]
            },
            "payload_mass_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "min_pickplace_z_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "radial_workspace_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "arbitrary_object_orientation": {
              "type": "string"
            },
            "limits_source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "sensing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "camera_required",
            "camera_is_default_robot_property",
            "camera_present",
            "camera_presence_basis",
            "camera_model",
            "camera_mount_pose",
            "camera_integration_status",
            "camera_source_meets_tool_gate",
            "camera_publication",
            "autonomous_perception_skill",
            "note_zh"
          ],
          "properties": {
            "camera_required": {
              "type": "boolean",
              "const": true
            },
            "camera_is_default_robot_property": {
              "type": "boolean",
              "const": true
            },
            "camera_present": {
              "type": "boolean"
            },
            "camera_presence_basis": {
              "type": "string",
              "enum": [
                "source_integrated",
                "user_confirmed_default_with_builder_mount",
                "required_pending_adaptation"
              ]
            },
            "camera_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "camera_mount_pose": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "translation_m",
                "rotation_wxyz",
                "reference_frame",
                "mounting",
                "visual_shell_calibration"
              ],
              "properties": {
                "translation_m": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation_wxyz": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "reference_frame": {
                  "type": "string"
                },
                "mounting": {
                  "type": "string"
                },
                "visual_shell_calibration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "translate_m",
                    "rotate_xyz_deg",
                    "scale",
                    "reference_frame"
                  ],
                  "properties": {
                    "translate_m": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rotate_xyz_deg": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "scale": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "reference_frame": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "camera_integration_status": {
              "type": "string",
              "enum": [
                "integrated",
                "builder_registered_default",
                "pending_adaptation"
              ]
            },
            "camera_source_meets_tool_gate": {
              "type": "boolean"
            },
            "camera_publication": {
              "type": "string"
            },
            "autonomous_perception_skill": {
              "type": "string"
            },
            "note_zh": {
              "type": "string"
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "support",
              "availability",
              "support_basis",
              "backend",
              "operations",
              "requirements_zh",
              "limitations_zh"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "enum": [
                  "eai.navigation.node_route",
                  "eai.manipulation.pick_place"
                ]
              },
              "support": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "supported_unstable",
                  "unknown",
                  "not_applicable"
                ]
              },
              "availability": {
                "type": "string",
                "enum": [
                  "pending_binding",
                  "pending_configuration_validation",
                  "pending_integration",
                  "deployment_blocked",
                  "not_supported",
                  "provider_pending"
                ]
              },
              "support_basis": {
                "type": "string",
                "enum": [
                  "source_analysis",
                  "user_confirmed_project_capability"
                ]
              },
              "backend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requirements_zh": {
