            "registered_blocked",
            "conditional",
            "rejected",
            "declared_unwired",
            "pending_integration"
          ],
          "properties": {
            "catalog_registered": {
              "type": "number"
            },
            "registered_blocked": {
              "type": "number"
            },
            "conditional": {
              "type": "number"
            },
            "rejected": {
              "type": "number"
            },
            "declared_unwired": {
              "type": "number"
            },
            "pending_integration": {
              "type": "number"
            }
