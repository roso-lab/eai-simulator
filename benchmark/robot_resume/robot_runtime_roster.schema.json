{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heterocoord.local/schema/robot_runtime_roster.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "policy", "formal_gates", "membership_counts", "excluded_resume_ids", "shared_runtime_condition", "restriction_codes", "sources", "robots"],
  "properties": {
    "schema_id": {"const": "heterocoord.robot_runtime_roster"},
    "schema_version": {"const": "1.0.0"},
    "policy": {"type": "string", "minLength": 1},
    "formal_gates": {"type": "object", "additionalProperties": false, "required": ["runtime_qualified", "physical_qualified", "rankable", "paper_score_eligible"], "properties": {"runtime_qualified": {"const": false}, "physical_qualified": {"const": false}, "rankable": {"const": false}, "paper_score_eligible": {"const": false}}},
    "membership_counts": {"type": "object", "additionalProperties": false, "required": ["total", "pool", "independent_arm_immediate"], "properties": {"total": {"const": 27}, "pool": {"const": 25}, "independent_arm_immediate": {"const": 2}}},
    "excluded_resume_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "shared_runtime_condition": {"type": "string", "minLength": 1},
    "restriction_codes": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string"}},
    "sources": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "path", "sha256"], "properties": {"source_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "robots": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/robot"}},
    "promotion": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "robot": {"type": "object", "additionalProperties": false, "required": ["instance_id", "source_resume_id", "profile_id", "admission_class", "platform_type", "configuration_role", "asset_binding", "capability_binding", "initial_state_binding", "restrictions", "restriction_notes_zh", "runtime_qualified", "runtime_qualification_receipt", "qualification_policy"], "properties": {
      "instance_id": {"type": "string", "pattern": "^hc-rt-[0-9]{3}$"},
      "source_resume_id": {"type": "string", "minLength": 1},
      "profile_id": {"type": "string", "minLength": 1},
      "admission_class": {"enum": ["pool", "independent_arm_immediate"]},
      "platform_type": {"type": "string", "minLength": 1},
      "configuration_role": {"type": "string", "minLength": 1},
      "asset_binding": {"type": "object", "additionalProperties": false, "required": ["asset_sources", "asset_digest"], "properties": {"asset_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}}}, "asset_digest": {"$ref": "#/$defs/digest"}}},
      "capability_binding": {"type": "object", "additionalProperties": false, "required": ["skill_bindings", "capability_digest", "source_input"], "properties": {"skill_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "provider_version", "schema_version", "backend"], "properties": {"skill_id": {"type": "string"}, "provider_version": {"type": "string"}, "schema_version": {"type": "string"}, "backend": {"type": ["string", "null"]}}}}, "capability_digest": {"$ref": "#/$defs/digest"}, "source_input": {"type": "object"}}},
      "initial_state_binding": {"type": "object", "additionalProperties": false, "required": ["initial_state", "initial_state_digest"], "properties": {"initial_state": {"type": "object", "required": ["schema_version", "source", "pose", "joint_state", "binding_status"]}, "initial_state_digest": {"$ref": "#/$defs/digest"}}},
      "restrictions": {"type": "array", "items": {"type": "string"}},
      "restriction_notes_zh": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "runtime_qualified": {"type": "boolean"},
      "runtime_qualification_receipt": {"anyOf": [{"type": "null"}, {"type": "object"}]},
      "qualification_policy": {"const": "no_receipt_no_true"}
    }}
  }
}
