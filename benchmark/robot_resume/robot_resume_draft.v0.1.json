    },
    "coco": {
      "mobility": "ackermann_wheeled",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation"],
      "special_notes": ["车式转向，不按全向横移或原地旋转机器人分配动作。"]
    },
    "go2": {
      "mobility": "quadruped",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation"],
      "stairs": {"ascent": "unknown", "descent": "unknown", "render": "when_task_relevant"},
      "special_notes": ["上下楼按实际控制器、负载和路线分别确认，不从四足形态推断。"]
    },
    "b2": {
      "mobility": "quadruped",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation"],
      "stairs": {"ascent": "unknown", "descent": "unknown", "render": "when_task_relevant"},
      "special_notes": ["使用 B2 自身配置与证据，不套用 Go2 参数。"]
    },
    "m20": {
      "mobility": "wheel_legged",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation"],
      "stairs": {"ascent": "unknown", "descent": "unknown", "render": "when_task_relevant"},
