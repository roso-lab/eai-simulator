      "provenance": "user_supplied_project_limits",
      "height_frame_confirmation": "user_confirmed_manipulator_mount_base"
    },
    "lite3_stairs": "user_confirmed_not_supported_in_current_project",
    "standalone_ur5": "user_confirmed_independent_robot",
    "catalog": "source/EAI/EAI/hmrs_env/env_diy/catalog.py",
    "skill_registry": "algorithm/skills/registry.py"
  },
  "semantics": {
    "profile_key": "可读配置模板名，不是 robot_id 或真实配置摘要",
    "configuration_id": "实际资产、安装外参、附件、夹具、传感器、控制器和后端版本的配置身份；示例尚未生成",
    "robot_id": "同一次会话中的唯一实例；独立 UR5 也有自己的 ID",
    "mounted_manipulator_identity_policy": "外挂臂作为组合机器人的组成部分，不重复登记为独立成员；独立安装的 UR5 单独登记。",
    "capability_support_values": ["supported", "unsupported", "unknown", "not_applicable"],
    "skill_availability_values": ["pending_binding", "available", "unavailable", "disabled", "unknown"],
    "unknown_policy": "缺失/null 表示未知，不表示零或不支持；关键资格未知时不得发布为已可执行",
    "publish_policy": "只将实际绑定和约束确认后 availability=available 的技能发布为可用技能",
    "render_policy": "特殊限制始终展示；常识限制可按任务相关性展示；机器判定始终读取结构化字段",
    "manipulator_origin_values": ["none", "attached", "integrated", "primary_robot"],
    "state_policy": "只填入观测/通信规则允许知道的实例状态",
    "reconfiguration_policy": "装卸臂或修改控制/后端后更新配置身份、简历版本及 generation，并重新验证受影响能力"
  },
