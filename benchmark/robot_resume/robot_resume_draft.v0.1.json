    },
    "pepper": {
      "mobility": "holonomic_virtual_joints",
      "manipulator_origin": "integrated",
      "skill_template_refs": ["node_navigation", "pepper_pick_place"],
      "special_notes": ["原生双臂的可用性由实例后端决定，不套用 UR5/Z1 参数。"]
    },
    "g1": {
      "mobility": "configuration_specific",
      "manipulator_origin": "integrated",
      "skill_template_refs": [],
      "requires_variant": true,
      "special_notes": ["必须选择行走配置或固定基座抓放配置，不能合并两者能力。"]
    },
    "cf2x": {
      "mobility": "aerial",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation"],
      "special_notes": ["当前统一无人机抓放后端未列 CF2X，不发布推测的抓放能力。"]
    },
    "iris": {
      "mobility": "aerial",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation", "aerial_pick_place"],
      "special_notes": ["局部抓放须使用受支持的位置控制与物理挂接后端；飞行载荷单独确认。"]
    },
    "pegasus": {
      "mobility": "aerial",
      "manipulator_origin": "none",
      "skill_template_refs": ["node_navigation", "aerial_pick_place"],
      "special_notes": ["局部抓放须使用受支持的位置控制与物理挂接后端；旋翼控制模式不自动满足该条件。"]
    }
