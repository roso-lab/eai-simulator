  "skill_templates": {
    "node_navigation": {
      "skill_id": "eai.navigation.node_route",
      "availability": "pending_binding",
      "requires": ["instance_navigation_adapter", "instance_topology", "configuration_traversability_check"],
      "description": "导航至本实例地图中的指定节点；楼梯不是独立公共 skill。"
    },
    "arm_local_pick_place": {
      "skill_id": "eai.manipulation.pick_place",
      "operations": ["pick", "place"],
      "backend": "ArmPickPlaceAdapter",
      "availability": "pending_binding",
      "execution_mode": "idealized_manipulation_runtime",
      "requires": ["instance_arm_backend", "gripper_or_explicit_grasp_mechanism", "valid_mount_pose", "applicable_limits", "reachable_target_and_recovery"],
      "constraints": ["local_operation", "no_arbitrary_object_orientation", "holding_navigation_requires_separate_support"]
    },
    "g1_fixed_pick_place": {
      "skill_id": "eai.manipulation.pick_place",
      "operations": ["pick", "place"],
      "backend": "G1PickPlaceAdapter",
      "availability": "pending_binding",
      "requires": ["fixed_base", "calibrated_hand_and_objects", "instance_backend"],
      "constraints": ["no_locomotion_in_this_configuration", "upright_axial_objects_only", "no_arbitrary_object_orientation"]
    },
    "pepper_pick_place": {
      "skill_id": "eai.manipulation.pick_place",
      "operations": ["pick", "place"],
      "backend": "PepperPickPlaceAdapter",
      "availability": "pending_binding",
      "requires": ["instance_composite_controller", "instance_backend", "prepared_object_collision_filter"],
      "constraints": ["no_arbitrary_object_orientation", "do_not_apply_ur5_or_z1_limits"]
    },
    "aerial_pick_place": {
      "skill_id": "eai.manipulation.pick_place",
      "operations": ["pick", "place"],
      "backend": "DronePickPlaceAdapter",
      "availability": "pending_binding",
      "requires": ["PegasusIris_or_PegasusX4", "supported_goal_position_controller", "instance_transport_bridge"],
      "constraints": ["fixed_joint_attachment_mode", "no_arbitrary_object_orientation", "do_not_apply_ur5_or_z1_limits"]
    }
  },
  "base_templates": {
    "carter": {
      "mobility": "differential_wheeled",
      "manipulator_origin": "none",
