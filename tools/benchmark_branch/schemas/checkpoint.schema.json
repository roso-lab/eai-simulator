{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heterocoord.checkpoint.v1",
  "type": "object",
  "required": ["checkpoint_id", "snapshot_digest", "snapshot_schema"],
  "properties": {
    "checkpoint_id": {"type": "string"},
    "simulator_step": {"type": "integer", "minimum": 0},
    "sim_time_s": {"type": "number"},
    "snapshot_digest": {"type": "string", "minLength": 1},
    "snapshot_schema": {"type": "string", "minLength": 1},
    "restore_passed": {"type": ["boolean", "null"]},
    "restore_status": {"type": "string"}
  },
  "additionalProperties": true
}
