+def finite_ray_base_height_l2(
+    env: ManagerBasedRLEnv,
+    target_height: float,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    sensor_cfg: SceneEntityCfg = SceneEntityCfg("height_scanner"),
+) -> torch.Tensor:
+    """Track base clearance using valid height rays only.
+
+    A ray cast over a true gap returns ``inf``.  The standard Isaac Lab
+    reward averages every ray and consequently becomes NaN there.  Masking
+    misses retains the useful stair-height signal while making the term
+    neutral only when *all* rays miss (the robot is fully above a gap).
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    sensor: RayCaster = env.scene.sensors[sensor_cfg.name]
+    hit_heights = sensor.data.ray_hits_w[..., 2]
+    valid_hits = torch.isfinite(hit_heights)
+    hit_count = valid_hits.sum(dim=1)
+    terrain_height = torch.where(valid_hits, hit_heights, 0.0).sum(dim=1) / hit_count.clamp_min(1)
+    # If all rays miss, there is no local ground-height target to follow.
+    terrain_height = torch.where(hit_count > 0, terrain_height, asset.data.root_pos_w[:, 2] - target_height)
+    return torch.square(asset.data.root_pos_w[:, 2] - (terrain_height + target_height))
+
+
+def jump_gated_finite_ray_base_height_l2(
+    env: ManagerBasedRLEnv,
+    target_height: float,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    sensor_cfg: SceneEntityCfg = SceneEntityCfg("height_scanner"),
+    command_name: str = "jump",
+    jump_scale: float = 0.2,
+) -> torch.Tensor:
+    """Keep stable clearance on stairs without discouraging take-off."""
+    height_error = finite_ray_base_height_l2(env, target_height, asset_cfg, sensor_cfg)
+    return height_error * _jump_relaxation(env, command_name, jump_scale)
+
+
+def gap_gated_finite_ray_base_height_l2(
+    env: ManagerBasedRLEnv,
+    target_height: float,
+    terrain_type_range: tuple[int, int],
+    gap_scale: float,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    sensor_cfg: SceneEntityCfg = SceneEntityCfg("height_scanner"),
+) -> torch.Tensor:
+    """Relax clearance tracking on real gap columns without a jump command."""
+
+    if not 0.0 <= gap_scale <= 1.0:
+        raise ValueError("gap_scale must be in [0, 1].")
+    height_error = finite_ray_base_height_l2(env, target_height, asset_cfg, sensor_cfg)
+    first_column, last_column = terrain_type_range
+    terrain_types = env.scene.terrain.terrain_types
+    is_gap = (terrain_types >= first_column) & (terrain_types <= last_column)
+    return height_error * torch.where(is_gap, gap_scale, 1.0)
+
+
+def jump_airborne(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+    command_name: str = "jump",
+    min_forward_speed: float = 0.15,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Reward a controlled four-foot flight while the internal gap cue is active."""
+    contact_sensor: ContactSensor = env.scene.sensors[sensor_cfg.name]
+    asset: Articulation = env.scene[asset_cfg.name]
+    all_feet_airborne = torch.all(contact_sensor.data.current_air_time[:, sensor_cfg.body_ids] > 0.0, dim=1)
+    moving_forward = asset.data.root_lin_vel_b[:, 0].clamp_min(0.0) / min_forward_speed
+    moving_forward = moving_forward.clamp_max(1.0)
+    jump_active = env.command_manager.get_command(command_name).squeeze(-1).clamp(0.0, 1.0)
+    return all_feet_airborne.float() * moving_forward * jump_active
+
+
+def gap_outward_velocity(
+    env: ManagerBasedRLEnv,
+    command_name: str = "jump",
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Reward outward velocity from the central platform during a gap approach.
+
+    This is direction-independent, matching the random reset yaw and the
+    four-sided MeshGap terrain.  It gives PPO a dense signal that standing at
+    the edge is worse than committing to the crossing.
+    """
+    asset: Articulation = env.scene[asset_cfg.name]
+    offset_xy = asset.data.root_pos_w[:, :2] - env.scene.env_origins[:, :2]
+    direction = offset_xy / torch.linalg.vector_norm(offset_xy, dim=1, keepdim=True).clamp_min(0.10)
+    outward_velocity = torch.sum(asset.data.root_lin_vel_w[:, :2] * direction, dim=1).clamp_min(0.0)
+    jump_active = env.command_manager.get_command(command_name).squeeze(-1).clamp(0.0, 1.0)
+    return outward_velocity * jump_active
+
