+    experiment_name = "go2_distill"
+    # RSL-RL 的观测组映射：
+    # policy 是“学生策略”的输入组，这里取环境 observations.student。
+    # teacher 是“教师策略”的输入组，这里取环境 observations.policy。
+    obs_groups = {
+        "policy": ["student"],
+        "teacher": ["policy"],
+    }
+    # 教师：
+    # 当前完整观测 → MLP → 动作
+
+    # 学生：
+    # 当前有限观测 + 历史隐藏状态 → 单层GRU → MLP → 动作
+    policy = RslRlDistillationStudentTeacherRecurrentCfg(
