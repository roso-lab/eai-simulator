+class _CustomActorOnnxExporter(torch.nn.Module):
+    """ONNX wrapper for actors that expose their input dimension explicitly.
+
+    Isaac Lab's stock exporter reads ``actor[0].in_features``, which only
+    works for ``nn.Sequential`` actors.  The parkour teacher uses a custom
+    module because it contains sparse-MoE routing, so it exposes ``input_dim``
+    instead.
+    """
+
+    def __init__(self, actor: torch.nn.Module, normalizer: torch.nn.Module | None):
+        super().__init__()
+        self.actor = copy.deepcopy(actor)
+        self.normalizer = copy.deepcopy(normalizer) if normalizer is not None else torch.nn.Identity()
+
+    def forward(self, obs: torch.Tensor) -> torch.Tensor:
+        return self.actor(self.normalizer(obs))
+
+
+def _export_policy_onnx(policy: torch.nn.Module, normalizer: torch.nn.Module | None, path: str, filename: str) -> None:
+    """Export custom actors without relying on Isaac Lab's Sequential-only assumption."""
+
+    actor = getattr(policy, "actor", None)
+    input_dim = getattr(actor, "input_dim", None)
+    if input_dim is None:
+        export_policy_as_onnx(policy, normalizer=normalizer, path=path, filename=filename)
+        return
+    if policy.is_recurrent:
+        raise NotImplementedError("Custom ONNX export with input_dim does not support recurrent policies.")
+
+    exporter = _CustomActorOnnxExporter(actor, normalizer).to("cpu").eval()
+    obs = torch.zeros(1, input_dim)
+    torch.onnx.export(
+        exporter,
+        obs,
+        os.path.join(path, filename),
+        export_params=True,
+        opset_version=18,
+        input_names=["obs"],
+        output_names=["actions"],
+        dynamic_axes={},
+    )
+
+
+class _GaitDiagnosticRecorder:
+    """Capture a compact, single-environment gait trace during policy playback.
+
+    This is deliberately a playback-only utility: it reads simulator state but
+    never modifies actions, rewards, observations, or environment settings.
+    """
+
+    def __init__(self, env, env_id: int, step_dt: float, output_dir: Path):
+        self.env = env
+        self.env_id = env_id
+        self.step_dt = float(step_dt)
+        self.output_dir = output_dir
+        self.records: dict[str, list[np.ndarray]] = {
+            "contact": [],
+            "foot_force_w": [],
+            "foot_pos_w": [],
+            "joint_pos": [],
+            "joint_vel": [],
+            "joint_torque": [],
+            "action": [],
+            "root_pos_w": [],
+            "root_lin_vel_b": [],
+            "done": [],
+        }
+
+        scene = env.scene
+        self.asset = scene["robot"]
+        self.contact_sensor = scene["contact_forces"]
+        self.terrain = getattr(scene, "terrain", None)
+        self.foot_ids, foot_names = self.contact_sensor.find_bodies([".*_foot"])
+        self.foot_ids = list(self.foot_ids)
+        self.foot_names = list(foot_names)
+        if len(self.foot_ids) != 4:
+            raise ValueError(
+                "Gait diagnosis expects exactly four bodies matching '.*_foot', "
+                f"but resolved {len(self.foot_ids)}: {self.foot_names}."
+            )
+        if not 0 <= env_id < env.num_envs:
+            raise ValueError(f"--diagnostic-env-id must be in [0, {env.num_envs - 1}], got {env_id}.")
+
+        self.action_term_name, self.action_joint_names = self._resolve_action_joint_names()
+        print("[INFO] Gait diagnostic resolved:")
+        print(f"  environment index: {self.env_id}")
+        print(f"  robot joint order: {list(self.asset.joint_names)}")
+        print(f"  action term: {self.action_term_name}")
+        print(f"  action joint order: {self.action_joint_names}")
+        print(f"  foot body order: {self.foot_names}")
+
+    def _resolve_action_joint_names(self) -> tuple[str, list[str]]:
+        """Best-effort action-order lookup, retained in metadata for auditability."""
+        try:
+            manager = self.env.action_manager
+            term_names = list(manager.active_terms)
+            if len(term_names) != 1:
+                return f"<expected one action term, got {term_names}>", []
+            term_name = term_names[0]
+            term = manager.get_term(term_name)
+            joint_ids = getattr(term, "joint_ids", None)
+            if joint_ids is None:
+                return term_name, []
+            if hasattr(joint_ids, "tolist"):
+                joint_ids = joint_ids.tolist()
+            return term_name, [self.asset.joint_names[index] for index in joint_ids]
+        except (AttributeError, KeyError, TypeError, IndexError) as error:
+            return f"<unavailable: {error}>", []
+
+    @staticmethod
+    def _cpu_array(value: torch.Tensor) -> np.ndarray:
+        return value.detach().to("cpu").numpy().copy()
+
+    def capture(self, actions: torch.Tensor) -> None:
+        """Record the state immediately before the associated action is stepped."""
+        idx = self.env_id
+        forces_w = self.contact_sensor.data.net_forces_w[idx, self.foot_ids]
+        contact = torch.linalg.vector_norm(forces_w, dim=-1) > 1.0
+        self.records["contact"].append(self._cpu_array(contact))
+        self.records["foot_force_w"].append(self._cpu_array(forces_w))
+        self.records["foot_pos_w"].append(self._cpu_array(self.asset.data.body_pos_w[idx, self.foot_ids]))
+        self.records["joint_pos"].append(self._cpu_array(self.asset.data.joint_pos[idx]))
+        self.records["joint_vel"].append(self._cpu_array(self.asset.data.joint_vel[idx]))
+        self.records["joint_torque"].append(self._cpu_array(self.asset.data.applied_torque[idx]))
+        self.records["action"].append(self._cpu_array(actions[idx]))
+        self.records["root_pos_w"].append(self._cpu_array(self.asset.data.root_pos_w[idx]))
+        self.records["root_lin_vel_b"].append(self._cpu_array(self.asset.data.root_lin_vel_b[idx]))
+        # Terrain IDs are essential context when comparing traces: a gait
+        # segment on a gap should not be judged by the same load criterion as
+        # an unobstructed walking segment.
+        if self.terrain is not None and hasattr(self.terrain, "terrain_types"):
+            self.records.setdefault("terrain_type", []).append(self._cpu_array(self.terrain.terrain_types[idx]))
+        if self.terrain is not None and hasattr(self.terrain, "terrain_levels"):
+            self.records.setdefault("terrain_level", []).append(self._cpu_array(self.terrain.terrain_levels[idx]))
+
+    def record_done(self, dones: torch.Tensor) -> None:
+        self.records["done"].append(np.asarray(bool(dones[self.env_id].item()), dtype=np.bool_))
+
+    def write(self) -> Path:
+        if not self.records["contact"]:
+            raise RuntimeError("No gait diagnostic samples were captured.")
+
+        self.output_dir.mkdir(parents=True, exist_ok=True)
+        arrays = {name: np.stack(values) for name, values in self.records.items()}
+        arrays["time_s"] = np.arange(len(arrays["contact"]), dtype=np.float64) * self.step_dt
+        raw_path = self.output_dir / "gait_trace.npz"
+        np.savez_compressed(raw_path, **arrays)
+
+        metadata = {
+            "environment_index": self.env_id,
+            "step_dt_s": self.step_dt,
+            "samples": int(arrays["contact"].shape[0]),
+            "contact_force_threshold_n": 1.0,
+            "foot_body_names": self.foot_names,
+            "robot_joint_names": list(self.asset.joint_names),
+            "action_term": self.action_term_name,
+            "action_joint_names": self.action_joint_names,
+            "raw_trace": raw_path.name,
+        }
+        with (self.output_dir / "metadata.json").open("w", encoding="utf-8") as file:
+            json.dump(metadata, file, ensure_ascii=False, indent=2)
+
+        # Integrate upward force over time.  This exposes a foot that makes
+        # binary contact but contributes almost no support impulse.
+        upward_force = np.maximum(arrays["foot_force_w"][..., 2], 0.0)
+        contact = arrays["contact"].astype(bool)
+        done = arrays["done"].astype(bool)
+        summary_path = self.output_dir / "foot_summary.csv"
+        with summary_path.open("w", newline="", encoding="utf-8") as file:
+            writer = csv.DictWriter(
+                file,
+                fieldnames=(
+                    "foot",
+                    "contact_duty_factor",
+                    "mean_upward_force_n",
+                    "mean_upward_force_when_contact_n",
+                    "upward_impulse_ns",
+                    "stance_segments",
+                    "mean_stance_duration_s",
+                    "median_stance_duration_s",
+                ),
+            )
+            writer.writeheader()
+            for foot_index, foot_name in enumerate(self.foot_names):
+                durations = self._stance_durations(contact[:, foot_index], done)
+                in_contact_forces = upward_force[contact[:, foot_index], foot_index]
+                writer.writerow(
+                    {
+                        "foot": foot_name,
+                        "contact_duty_factor": float(contact[:, foot_index].mean()),
+                        "mean_upward_force_n": float(upward_force[:, foot_index].mean()),
+                        "mean_upward_force_when_contact_n": float(in_contact_forces.mean())
+                        if len(in_contact_forces)
+                        else 0.0,
+                        "upward_impulse_ns": float(upward_force[:, foot_index].sum() * self.step_dt),
+                        "stance_segments": len(durations),
+                        "mean_stance_duration_s": float(np.mean(durations)) if durations else 0.0,
+                        "median_stance_duration_s": float(np.median(durations)) if durations else 0.0,
+                    }
+                )
+        return self.output_dir
+
+    def _stance_durations(self, contacts: np.ndarray, dones: np.ndarray) -> list[float]:
+        durations: list[float] = []
+        current = 0.0
+        for is_contact, is_done in zip(contacts, dones, strict=True):
+            if is_contact:
+                current += self.step_dt
+            if not is_contact or is_done:
+                if current > 0.0:
+                    durations.append(current)
+                    current = 0.0
+        if current > 0.0:
+            durations.append(current)
+        return durations
+
