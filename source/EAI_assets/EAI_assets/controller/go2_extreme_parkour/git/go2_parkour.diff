+def tracking_goal_velocity(
+    env: ManagerBasedRLEnv,
+    goal_command_name: str = "parkour_waypoint",
+    velocity_command_name: str = "base_velocity",
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Reward velocity projected along the current target direction.
+
+    This is the Parkour goal-velocity reward: matching the commanded speed in
+    the target direction yields one, standing yields zero, and moving away is
+    negative.  The target direction is supplied by the goal command, not a
+    jump cue or a fixed post-gap travel distance.
+    """
+
+    projected_velocity, command_speed = _goal_direction_projection(
+        env, goal_command_name, velocity_command_name, asset_cfg
+    )
+    active = command_speed > 1.0e-6
+    reward = torch.minimum(projected_velocity, command_speed) / command_speed.clamp_min(1.0e-6)
+    return torch.where(active, reward, torch.zeros_like(reward))
+
+
+def goal_direction_stall_penalty(
+    env: ManagerBasedRLEnv,
+    goal_command_name: str = "parkour_waypoint",
+    velocity_command_name: str = "base_velocity",
+    minimum_speed_ratio: float = 0.5,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Penalize insufficient velocity along the current target direction."""
+
+    if not 0.0 < minimum_speed_ratio <= 1.0:
+        raise ValueError("minimum_speed_ratio must be in (0, 1].")
+    projected_velocity, command_speed = _goal_direction_projection(
+        env, goal_command_name, velocity_command_name, asset_cfg
+    )
+    active = command_speed > 1.0e-6
+    speed_ratio = projected_velocity / command_speed.clamp_min(1.0e-6)
+    shortfall = ((minimum_speed_ratio - speed_ratio) / minimum_speed_ratio).clamp(0.0, 1.0)
+    return torch.where(active, shortfall, torch.zeros_like(shortfall))
+
