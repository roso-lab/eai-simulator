+class GapWaypointProgress(ManagerTermBase):
+    """Reward progress toward a hidden waypoint placed beyond the gap.
+
+    The waypoint is deliberately reward-only: it is not exposed in either
+    teacher or student observations, and no visual marker is spawned.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self._active = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+        self._goal_pos_w = torch.zeros(env.num_envs, 2, device=env.device)
+        self._previous_distance = torch.zeros(env.num_envs, device=env.device)
+
+    def reset(self, env_ids=None) -> None:
+        if env_ids is None:
+            self._active[:] = False
+            self._previous_distance[:] = 0.0
+        else:
+            self._active[env_ids] = False
+            self._previous_distance[env_ids] = 0.0
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        command_name: str = "jump",
+        goal_axis_distance: float = 3.0,
+        max_progress_speed: float = 1.5,
+        asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    ) -> torch.Tensor:
+        """Return distance reduction per second after the jump approach begins."""
+        asset: Articulation = env.scene[asset_cfg.name]
+        jump_active = env.command_manager.get_command(command_name).squeeze(-1) > 0.5
+        new_goal = jump_active & ~self._active
+
+        if torch.any(new_goal):
+            # 中文：用起跳前的机身朝向决定目标点在哪一侧，因而四个方向的 gap 都适用。
+            local_forward = torch.zeros_like(asset.data.root_pos_w)
+            local_forward[:, 0] = 1.0
+            forward_xy = quat_apply(yaw_quat(asset.data.root_quat_w), local_forward)[:, :2]
+            forward_xy /= torch.linalg.vector_norm(forward_xy, dim=1, keepdim=True).clamp_min(1.0e-6)
+
+            # 中文：目标点的 x 或 y 坐标距中心 3 m，落在最宽 0.4 m gap 外约 1 m 的实地上。
+            # 采用 max(|x|, |y|) 归一化后，斜着走时也不会把目标点放到方形地形外面。
+            to_goal = forward_xy * (
+                goal_axis_distance / forward_xy.abs().max(dim=1, keepdim=True).values.clamp_min(1.0e-6)
+            )
+            self._goal_pos_w[new_goal] = env.scene.env_origins[new_goal, :2] + to_goal[new_goal]
+            initial_distance = torch.linalg.vector_norm(
+                asset.data.root_pos_w[new_goal, :2] - self._goal_pos_w[new_goal], dim=1
+            )
+            self._previous_distance[new_goal] = initial_distance
+            self._active[new_goal] = True
+
+        current_distance = torch.linalg.vector_norm(asset.data.root_pos_w[:, :2] - self._goal_pos_w, dim=1)
+        # 中文：每一步只奖励“比上一帧更靠近目标点”的距离；后退会得到负值，原地则为零。
+        progress = (self._previous_distance - current_distance) / env.step_dt
+        self._previous_distance[self._active] = current_distance[self._active]
+        return torch.where(self._active, progress.clamp(-max_progress_speed, max_progress_speed), 0.0)
+
+
+class GapCrossingSuccess(ManagerTermBase):
+    """Emit one reward pulse when an episode first reaches the outer gap ring."""
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self._rewarded = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+
+    def reset(self, env_ids=None) -> None:
+        if env_ids is None:
+            self._rewarded[:] = False
+        else:
+            self._rewarded[env_ids] = False
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        command_name: str = "jump",
+        outer_ring_distance: float = 2.0,
+        minimum_root_height: float = 0.18,
+        asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    ) -> torch.Tensor:
+        asset: Articulation = env.scene[asset_cfg.name]
+        offset_xy = (asset.data.root_pos_w[:, :2] - env.scene.env_origins[:, :2]).abs()
+        # MeshGapTerrainCfg is square: max(|x|, |y|) identifies arrival beyond
+        # the central platform plus the widest 0.4 m gap.
+        reached_outer_ring = offset_xy.max(dim=1).values >= outer_ring_distance
+        safely_above_terrain = asset.data.root_pos_w[:, 2] >= env.scene.env_origins[:, 2] + minimum_root_height
+        jump_active = env.command_manager.get_command(command_name).squeeze(-1) > 0.5
+        newly_crossed = reached_outer_ring & safely_above_terrain & jump_active & ~self._rewarded
+        self._rewarded |= newly_crossed
+        # RewardManager multiplies every term by step_dt, so divide here to make
+        # this a true one-off bonus rather than a 20-ms sliver of reward.
+        return newly_crossed.float() / env.step_dt
+
+
+class GapPostCrossVelocityTracking(ManagerTermBase):
+    """Keep rewarding the current velocity command after a successful gap crossing.
+
+    The term becomes active on the first safe landing outside a commanded gap
+    and remains active for the rest of that episode.  It deliberately has no
+    fixed distance or speed target: the target is always the current
+    ``base_velocity`` command.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self._crossed = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+
+    def reset(self, env_ids=None) -> None:
+        if env_ids is None:
+            self._crossed[:] = False
+        else:
+            self._crossed[env_ids] = False
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        command_name: str = "base_velocity",
+        jump_command_name: str = "jump",
+        std: float = 0.5,
+        outer_ring_distance: float = 2.0,
+        minimum_root_height: float = 0.18,
+        asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+    ) -> torch.Tensor:
+        asset: Articulation = env.scene[asset_cfg.name]
+        offset_xy = (asset.data.root_pos_w[:, :2] - env.scene.env_origins[:, :2]).abs()
+        reached_outer_ring = offset_xy.max(dim=1).values >= outer_ring_distance
+        safely_above_terrain = asset.data.root_pos_w[:, 2] >= env.scene.env_origins[:, 2] + minimum_root_height
+        jump_active = env.command_manager.get_command(jump_command_name).squeeze(-1) > 0.5
+        self._crossed |= reached_outer_ring & safely_above_terrain & jump_active
+
+        velocity_tracking = isaaclab_mdp.track_lin_vel_xy_exp(
+            env, std=std, command_name=command_name, asset_cfg=asset_cfg
+        )
+        return self._crossed.float() * velocity_tracking
+
+
+def feet_slip(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Penalize foot horizontal velocity while the foot is in contact."""
+    contact_sensor: ContactSensor = env.scene.sensors[sensor_cfg.name]
+    asset: Articulation = env.scene[asset_cfg.name]
+    contacts = contact_sensor.data.net_forces_w_history[:, :, sensor_cfg.body_ids, :].norm(dim=-1).max(dim=1)[0] > 1.0
+    feet_vel_xy = asset.data.body_lin_vel_w[:, asset_cfg.body_ids, :2]
+    return torch.sum(contacts * torch.sum(torch.square(feet_vel_xy), dim=-1), dim=1)
+
+
+def joint_deviation_l2(
+    env: ManagerBasedRLEnv,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Squared deviation of selected joints from their default pose.
+
+    This is the all-joint pose prior used by the reference Parkour task.  It
+    makes a permanently folded front thigh/calf costly even if that leg is not
+    currently bearing load.
+    """
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    joint_error = asset.data.joint_pos[:, asset_cfg.joint_ids] - asset.data.default_joint_pos[:, asset_cfg.joint_ids]
+    return torch.sum(torch.square(joint_error), dim=1)
+
+
+def action_rate_l2_norm(env: ManagerBasedRLEnv) -> torch.Tensor:
+    """L2 norm (not squared L2) of the action difference between two steps."""
+
+    action_delta = env.action_manager.action - env.action_manager.prev_action
+    return torch.linalg.vector_norm(action_delta, dim=1)
+
+
+def feet_stumble(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+) -> torch.Tensor:
+    """Return one when a selected foot has a severe lateral impact.
+
+    This matches the reference condition ``||F_xy|| > 4 * |F_z|`` and is a
+    collision penalty, unlike ``feet_slip`` which continuously discourages a
+    load-bearing foot from remaining on the ground.
+    """
+
+    contact_sensor: ContactSensor = env.scene.sensors[sensor_cfg.name]
+    net_forces = contact_sensor.data.net_forces_w[:, sensor_cfg.body_ids]
+    tangential_force = torch.linalg.vector_norm(net_forces[..., :2], dim=-1)
+    vertical_force = torch.abs(net_forces[..., 2])
+    return torch.any(tangential_force > 4.0 * vertical_force, dim=1).to(dtype=net_forces.dtype)
+
+
+class ExtremeParkourDofAcc(ManagerTermBase):
+    """Policy-step joint-acceleration penalty used by Isaaclab_Parkour.
+
+    The reference IsaacLab port does not use Isaac Lab's ``joint_acc`` buffer:
+    that buffer is updated on every 5 ms physics step.  Instead it records the
+    joint velocity once per 20 ms policy step and evaluates
+    ``sum(((qdot_t - qdot_{t-1}) / policy_dt)^2)``.  Keeping this history in
+    the reward term makes the Teacher objective match that implementation.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset_cfg: SceneEntityCfg = cfg.params["asset_cfg"]
+        asset: Articulation = env.scene[self.asset_cfg.name]
+        self.previous_joint_vel = torch.zeros(
+            env.num_envs, asset.num_joints, device=env.device, dtype=asset.data.joint_vel.dtype
+        )
+        self.policy_dt = env.step_dt
+
+    def reset(self, env_ids: Sequence[int] | None = None) -> None:
+        if env_ids is None:
+            self.previous_joint_vel.zero_()
+        else:
+            self.previous_joint_vel[env_ids] = 0.0
+
+    def __call__(self, env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
+        asset: Articulation = env.scene[asset_cfg.name]
+        current_joint_vel = asset.data.joint_vel
+        penalty = torch.sum(torch.square((current_joint_vel - self.previous_joint_vel) / self.policy_dt), dim=1)
+        self.previous_joint_vel.copy_(current_joint_vel)
+        return penalty
+
+
+class ExtremeParkourDeltaTorques(ManagerTermBase):
+    """Reference ``delta_torques`` penalty with a reset-safe torque history.
+
+    The original task penalizes ``sum((tau_t - tau_{t-1})^2)``.  This stateful
+    term keeps the previous applied torque per parallel environment, rather
+    than reusing an action-rate approximation.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset_cfg: SceneEntityCfg = cfg.params["asset_cfg"]
+        asset: Articulation = env.scene[self.asset_cfg.name]
+        self.previous_torque = torch.zeros(env.num_envs, asset.num_joints, device=env.device)
+
+    def reset(self, env_ids: Sequence[int] | None = None) -> None:
+        if env_ids is None:
+            self.previous_torque.zero_()
+        else:
+            self.previous_torque[env_ids] = 0.0
+
+    def __call__(self, env: ManagerBasedRLEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
+        asset: Articulation = env.scene[asset_cfg.name]
+        current_torque = asset.data.applied_torque
+        penalty = torch.sum(torch.square(current_torque - self.previous_torque), dim=1)
+        self.previous_torque.copy_(current_torque)
+        return penalty
+
+
+def extreme_parkour_collision(
+    env: ManagerBasedRLEnv,
+    sensor_cfg: SceneEntityCfg,
+) -> torch.Tensor:
+    """Count base/calf/thigh contacts using the original 0.1 N threshold."""
+
+    contact_sensor: ContactSensor = env.scene.sensors[sensor_cfg.name]
+    forces = contact_sensor.data.net_forces_w_history[:, 0, sensor_cfg.body_ids]
+    return torch.sum((torch.linalg.vector_norm(forces, dim=-1) > 0.1).to(forces.dtype), dim=1)
+
+
+def _extreme_parkour_is_flat(env: ManagerBasedRLEnv) -> torch.Tensor:
+    """Return the local five-track task's flat-terrain mask."""
+
+    # ``PARKOUR_TERRAINS_CFG`` assigns eight consecutive columns to each
+    # terrain type; columns 0--7 are the flat reference terrain.
+    return env.scene.terrain.terrain_types < 8
+
+
+def extreme_parkour_lin_vel_z(
+    env: ManagerBasedRLEnv,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Original vertical-velocity penalty: half weight off flat terrain."""
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    penalty = torch.square(asset.data.root_lin_vel_b[:, 2])
+    penalty[~_extreme_parkour_is_flat(env)] *= 0.5
+    return penalty
+
+
+def extreme_parkour_orientation(
+    env: ManagerBasedRLEnv,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Original orientation penalty, active only on flat terrain."""
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    penalty = torch.sum(torch.square(asset.data.projected_gravity_b[:, :2]), dim=1)
+    penalty[~_extreme_parkour_is_flat(env)] = 0.0
+    return penalty
+
+
+class ExtremeParkourFeetEdge(ManagerTermBase):
+    """Penalize contacting a height discontinuity on the local mesh tracks.
+
+    The legacy task reads a raster ``x_edge_mask``.  The local terrain is
+    generated from analytic meshes, so the equivalent mask is evaluated from
+    the same box/gap/hurdle/pad boundaries at each foot position.
+    """
+
+    def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRLEnv):
+        super().__init__(cfg, env)
+        self.asset_cfg: SceneEntityCfg = cfg.params["asset_cfg"]
+        self.sensor_cfg: SceneEntityCfg = cfg.params["sensor_cfg"]
+        self.edge_width = float(cfg.params.get("edge_width", 0.08))
+        self.asset: Articulation = env.scene[self.asset_cfg.name]
+        self.contact_sensor: ContactSensor = env.scene.sensors[self.sensor_cfg.name]
+
+    def reset(self, env_ids: Sequence[int] | None = None) -> None:
+        # No history is owned by this term; contact history belongs to the sensor.
+        pass
+
+    def __call__(
+        self,
+        env: ManagerBasedRLEnv,
+        asset_cfg: SceneEntityCfg,
+        sensor_cfg: SceneEntityCfg,
+        edge_width: float = 0.08,
+    ) -> torch.Tensor:
+        # Terrain origins are the safe reset origins at (x=1, y=2) in each
+        # 18 x 4 m local tile.  Convert world foot positions back to mesh
+        # coordinates before checking its analytic discontinuity boundaries.
+        feet_w = self.asset.data.body_pos_w[:, self.asset_cfg.body_ids, :2]
+        feet_local = feet_w - env.scene.terrain.env_origins[:, None, :2]
+        x = feet_local[..., 0] + 1.0
+        y = feet_local[..., 1] + 2.0
+        width = float(edge_width)
+        near_edge = torch.zeros_like(x, dtype=torch.bool)
+
+        terrain_kind = torch.div(env.scene.terrain.terrain_types, 8, rounding_mode="floor")
+        difficulty = env.scene.terrain.terrain_levels.to(x.dtype) / 9.0
+
+        # Steps: six 1.35 m boxes with 0.35 m discontinuities between them.
+        is_box = terrain_kind == 1
+        for index in range(6):
+            x_min = 3.0 + 1.70 * index
+            x_max = x_min + 1.35
+            near_edge |= is_box[:, None] & ((x - x_min).abs() <= width)
+            near_edge |= is_box[:, None] & ((x - x_max).abs() <= width)
+
+        # Gaps: both trench lips are height discontinuities.  Width and landing
+        # length vary with curriculum difficulty exactly as the terrain does.
+        is_gap = terrain_kind == 2
+        gap_width = 0.10 + 0.70 * difficulty
+        landing_length = 1.50 - 0.25 * difficulty
+        x_cursor = torch.full_like(difficulty, 2.50)
+        for _ in range(6):
+            gap_start = x_cursor
+            gap_end = gap_start + gap_width
+            near_edge |= is_gap[:, None] & ((x - gap_start[:, None]).abs() <= width)
+            near_edge |= is_gap[:, None] & ((x - gap_end[:, None]).abs() <= width)
+            x_cursor = gap_end + landing_length
+
+        # Hurdles are transverse raised boxes.
+        is_hurdle = terrain_kind == 3
+        for center in (3.5, 5.7, 7.9, 10.1, 12.3, 14.5):
+            near_edge |= is_hurdle[:, None] & ((x - (center - 0.08)).abs() <= width)
+            near_edge |= is_hurdle[:, None] & ((x - (center + 0.08)).abs() <= width)
+
+        # Stones: include both longitudinal and lateral pad edges.
+        is_pads = terrain_kind == 4
+        pad_length = 1.00 - 0.40 * difficulty
+        pad_gap = 0.15 + 0.55 * difficulty
+        lateral_offset = 0.10 + 0.55 * difficulty
+        x_cursor = 2.0 + pad_gap
+        for index in range(6):
+            x_min = x_cursor
+            x_max = x_min + pad_length
+            center_y = 2.0 + (lateral_offset if index % 2 == 0 else -lateral_offset)
+            y_min = center_y - 0.5
+            y_max = center_y + 0.5
+            near_edge |= is_pads[:, None] & ((x - x_min[:, None]).abs() <= width)
+            near_edge |= is_pads[:, None] & ((x - x_max[:, None]).abs() <= width)
+            near_edge |= is_pads[:, None] & ((y - y_min[:, None]).abs() <= width)
+            near_edge |= is_pads[:, None] & ((y - y_max[:, None]).abs() <= width)
+            x_cursor = x_max + pad_gap
+
+        forces = self.contact_sensor.data.net_forces_w_history[:, :, self.sensor_cfg.body_ids]
+        current_contact = torch.linalg.vector_norm(forces[:, 0], dim=-1) > 2.0
+        previous_contact = torch.linalg.vector_norm(forces[:, -1], dim=-1) > 2.0
+        contact = current_contact | previous_contact
+        active = env.scene.terrain.terrain_levels > 3
+        return (active[:, None] & contact & near_edge).sum(dim=1).to(dtype=feet_w.dtype)