+def track_backward_lin_vel_xy_exp(
+    env: ManagerBasedRLEnv,
+    std: float,
+    command_name: str,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Reward signed velocity tracking only for negative forward-axis commands."""
+
+    reward = isaaclab_mdp.track_lin_vel_xy_exp(env, std, command_name, asset_cfg)
+    is_backward_command = env.command_manager.get_command(command_name)[:, 0] < -1.0e-6
+    return reward * is_backward_command
