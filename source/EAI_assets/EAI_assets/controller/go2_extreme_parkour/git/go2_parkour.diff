+def _goal_direction_projection(
+    env: ManagerBasedRLEnv,
+    goal_command_name: str,
+    velocity_command_name: str,
+    asset_cfg: SceneEntityCfg,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return velocity projected along the current body-frame waypoint yaw."""
+
+    asset: Articulation = env.scene[asset_cfg.name]
+    # ParkourWaypointCommand emits [current_yaw_error, next_yaw_error].  The
+    # velocity task needs the current target direction reconstructed from its
+    # first scalar; treating the two errors as an XY vector is incorrect.
+    current_yaw_error = env.command_manager.get_command(goal_command_name)[:, 0]
+    goal_direction_b = torch.stack((torch.cos(current_yaw_error), torch.sin(current_yaw_error)), dim=-1)
+    projected_velocity = torch.sum(goal_direction_b * asset.data.root_lin_vel_b[:, :2], dim=1)
+    command_speed = env.command_manager.get_command(velocity_command_name)[:, 0]
+    return projected_velocity, command_speed
+
