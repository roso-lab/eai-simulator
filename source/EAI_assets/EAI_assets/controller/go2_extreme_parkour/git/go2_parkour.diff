+def tracking_goal_yaw(
+    env: ManagerBasedRLEnv,
+    goal_command_name: str = "parkour_waypoint",
+    velocity_command_name: str = "base_velocity",
+) -> torch.Tensor:
+    """Exponentially reward aligning the base heading to the current waypoint.
+
+    This is the yaw objective used by both Extreme Parkour reference
+    implementations.  The waypoint command already wraps the angle; wrapping
+    once more here keeps the reward continuous at the +/-pi boundary.
+    """
+
+    yaw_error = env.command_manager.get_command(goal_command_name)[:, 0]
+    forward_command = env.command_manager.get_command(velocity_command_name)[:, 0] > 1.0e-6
+    reward = torch.exp(-torch.abs(wrap_to_pi(yaw_error)))
+    return torch.where(forward_command, reward, torch.zeros_like(reward))
+
